# Keep the build context (and image) lean and host-agnostic.
# Virtual envs are host-specific and must never be baked into the image.
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/

# Local database & build artifacts
db.sqlite3
db.sqlite3-journal
staticfiles/

# Test / tooling caches
.pytest_cache/
.coverage
htmlcov/

# Secrets & local config
.env
*.local

# VCS / editor / OS
.git/
.gitignore
.idea/
.vscode/
.DS_Store

# Docs not needed at runtime
requirements-py314.txt
