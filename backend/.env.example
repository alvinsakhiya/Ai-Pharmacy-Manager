# Copy to .env and adjust. Defaults are safe for local SQLite development.
DJANGO_SECRET_KEY=dev-insecure-change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Leave DATABASE_URL unset to use SQLite locally.
# For PostgreSQL (Docker): postgres://pharma:pharma@db:5432/pharmacy
# DATABASE_URL=postgres://pharma:pharma@db:5432/pharmacy

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT lifetimes (minutes / days)
ACCESS_TOKEN_LIFETIME_MIN=30
REFRESH_TOKEN_LIFETIME_DAYS=1
