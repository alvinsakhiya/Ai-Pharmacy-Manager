# Local backend configuration. Start PostgreSQL first with:
# docker compose up -d db
DJANGO_SECRET_KEY=dev-insecure-change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# PostgreSQL is required. Use localhost when Django runs outside Docker.
DATABASE_URL=postgresql://pharma:pharma@localhost:5433/pharmacy

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT lifetimes (minutes / days)
ACCESS_TOKEN_LIFETIME_MIN=30
REFRESH_TOKEN_LIFETIME_DAYS=1
LOGIN_THROTTLE_RATE=10/min
