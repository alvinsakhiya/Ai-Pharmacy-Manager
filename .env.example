DJANGO_SECRET_KEY=change-me-for-local-development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev

POSTGRES_DB=pharmacy
POSTGRES_USER=pharmacy
POSTGRES_PASSWORD=pharmacy
DATABASE_URL=postgresql://pharmacy:pharmacy@db:5432/pharmacy

CSRF_TRUSTED_ORIGINS=http://localhost:5173
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Application-level patient field encryption. Local development uses safe
# built-in fallbacks; production MUST set real values (the app refuses to start
# otherwise). Generate a Fernet key with:
#   docker compose exec backend python -c \
#     "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PATIENT_FIELD_KEY=
# HMAC key for the searchable last-name blind index (any long random string).
PATIENT_INDEX_KEY=

# Backup archive encryption (AES-256-GCM). Generate a key with:
#   docker compose exec backend python manage.py generate_backup_key
# Leave blank in local development to allow unencrypted dev backups.
# Set BACKUP_ENCRYPTION_REQUIRED=True to refuse backups when no key is present
# (this is the default in production). Never commit a real key.
BACKUP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_REQUIRED=False
# Optional: absolute path for backup storage (defaults to backend/media/backups/).
# Leave commented out to use the default; an empty value is treated as ".".
# BACKUP_ROOT=/var/lib/ai-pharmacy/backups

# Leave blank for Vite dev proxy. Set only when the browser should call an
# absolute API origin directly. WARNING: must stay same-origin/same-host with
# the SPA — session and CSRF cookies are not readable or sent cross-origin, so
# a cross-origin value silently breaks all authenticated requests. Production
# should serve the SPA and API behind one reverse proxy and leave this blank
# (see docs/ORACLE_FREE_VM_DEPLOYMENT.md).
VITE_API_BASE_URL=
# Where the Vite dev server proxies /api. For Docker Compose this must be the
# backend service name (containers cannot reach the backend via localhost).
# If you run the frontend manually on your host (outside Docker), use
# http://localhost:8000 instead.
API_PROXY_TARGET=http://backend:8000

TRUD_API_KEY=
TRUD_DMD_ITEM_ID=24
TRUD_DMD_RELEASE_FILE=

# --- Production overrides (for config.settings.prod; examples only, never
# --- commit real values). The production settings module fails to start unless
# --- DJANGO_SECRET_KEY, PATIENT_FIELD_KEY, PATIENT_INDEX_KEY and DATABASE_URL
# --- are set to real, non-default values.
# DJANGO_SETTINGS_MODULE=config.settings.prod
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=<a long random secret>
# DJANGO_ALLOWED_HOSTS=your-domain.example,203.0.113.10
# CSRF_TRUSTED_ORIGINS=https://your-domain.example
# CORS_ALLOWED_ORIGINS=https://your-domain.example
# DATABASE_URL=postgresql://user:password@db-host:5432/pharmacy
# BACKUP_ENCRYPTION_KEY=<from: python manage.py generate_backup_key>
# BACKUP_ENCRYPTION_REQUIRED=True
# LOG_LEVEL=INFO
# SESSION_COOKIE_AGE=43200
# Optional HTTPS overrides (secure defaults apply if unset):
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
